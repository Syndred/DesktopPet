{
  "appId": "com.lingjing.desktop",
  "productName": "Lingjing",
  "icon": "build/icon.png",
  "directories": {
    "output": "artifacts/pc-cloud-upgrade"
  },
  "files": [
    "apps/pc-app/dist/**/*",
    "apps/pc-app/runtime/features/*/assets/**/*",
    "apps/pc-app/runtime/assets/brand/**/*",
    "apps/pc-app/runtime/assets/illustrations/**/*",
    "!**/*.test.cjs",
    "!**/*.test.mjs",
    "!**/tests/**/*",
    "!**/verification/**/*",
    "!**/*.electron.mjs",
    "!**/verify-*.mjs",
    "!**/testing-adapter.cjs",
    "!**/generate-fish.cjs",
    "!**/write-evidence.mjs",
    "!**/prepare-*-fixture.mjs",
    "!**/assets/models/**/*",
    "!apps/pc-app/runtime/features/resources/legacy/**/*",
    "!node_modules/better-sqlite3/prebuilds/linux*.node",
    "!node_modules/better-sqlite3/prebuilds/darwin*.node",
    "!node_modules/better-sqlite3/prebuilds/win32-arm64.node",
    "!node_modules/better-sqlite3/src/**/*",
    "!node_modules/better-sqlite3/deps/**/*",
    "!node_modules/better-sqlite3/binding.gyp",
    "package.json"
  ],
  "asar": true,
  "extraFiles": [
    {
      "from": "apps/pc-app/ui/src/components/ui/LICENSE.shadcn",
      "to": "licenses/shadcn-ui.txt"
    },
    {
      "from": "docs/implementation/foundation-dependencies.json",
      "to": "licenses/dependencies.json"
    },
    {
      "from": "docs/implementation/illustration-assets.json",
      "to": "licenses/generated-illustrations.json"
    },
    {
      "from": "docs/implementation/garden-assets.json",
      "to": "licenses/generated-garden.json"
    },
    {
      "from": "apps/pc-app/runtime/features/resources/assets/roster-v2/source-record.json",
      "to": "licenses/generated-roster.json"
    },
    {
      "from": "apps/pc-app/runtime/features/resources/assets/roster-v2/generation-prompts.json",
      "to": "licenses/roster-generation-prompts.json"
    },
    {
      "from": "apps/pc-app/runtime/features/resources/assets/roster-v2/layout-refinement-prompts.json",
      "to": "licenses/roster-refinement-prompts.json"
    },
    {
      "from": "apps/pc-app/runtime/features/resources/assets/roster-v2/element-extension-prompts.json",
      "to": "licenses/roster-element-extension-prompts.json"
    },
    {
      "from": "apps/pc-app/runtime/features/resources/assets/roster-v2/element-extension-refinement.json",
      "to": "licenses/roster-element-extension-refinement.json"
    }
  ],
  "extraMetadata": {
    "main": "apps/pc-app/dist/main/index.cjs"
  },
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.png",
    "artifactName": "Lingjing-${version}-portable-${arch}.${ext}"
  },
  "npmRebuild": false,
  "asarUnpack": [
    "node_modules/better-sqlite3/prebuilds/win32-x64.node"
  ],
  "extraResources": [
    {
      "from": "config/lingjing-cloud-public.json",
      "to": "lingjing-cloud-public.json"
    }
  ]
}
