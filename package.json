{
  "name": "lingjing-desktop",
  "version": "0.1.8",
  "private": true,
  "description": "灵境 · 多宠物桌面伙伴",
  "workspaces": [
    "apps/pc-app",
    "apps/supabase-edge",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && tsc --noEmit -p apps/pc-app/tsconfig.desktop.json",
    "test": "vitest run",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:performance": "vitest run -c vitest.performance.config.ts",
    "test:security": "vitest run -c vitest.security.config.ts",
    "test:layers": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:performance && npm run test:security",
    "test:coverage": "vitest run --coverage",
    "release:build:pc": "node scripts/release/build-pc.mjs",
    "release:build:mobile": "node scripts/release/build-mobile.mjs",
    "release:build": "npm run release:build:pc && npm run release:build:mobile",
    "package:pc:win": "npm run build:pc && electron-builder --config scripts/release/electron-builder.pc.json --win portable --x64",
    "release:sign": "node scripts/release/sign-artifacts.mjs",
    "release:manifest": "node scripts/release/create-release-manifest.mjs",
    "release:prepare": "npm run release:build && npm run release:sign && npm run release:manifest",
    "release:rollback": "node scripts/release/rollback-release.mjs",
    "dev:pc": "node scripts/desktop/lingjing-launch.cjs dev",
    "start:pc": "node scripts/desktop/lingjing-launch.cjs preview",
    "pc:smoke": "node scripts/smoke/check-pc-runtime.mjs",
    "dr:backup": "node scripts/dr/backup-state.mjs",
    "dr:restore": "node scripts/dr/restore-state.mjs",
    "perf:report": "node scripts/perf/generate-weekly-report.mjs",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test:layers",
    "build:pc": "electron-vite build && node scripts/desktop/write-build-manifest.mjs",
    "typecheck:ui": "tsc --noEmit -p apps/pc-app/ui/tsconfig.json",
    "native:electron": "node scripts/desktop/verify-native.cjs",
    "package:pc:dir": "npm run build:pc && electron-builder --config scripts/release/electron-builder.pc.json --win --dir --x64",
    "test:foundation": "node scripts/desktop/run-native-tests.cjs tests/foundation/services.test.cjs tests/foundation/resource-backup.test.cjs tests/foundation/conversation-backup.test.cjs tests/foundation/owner-alias.test.cjs tests/foundation/cloud-checkpoint.test.cjs tests/foundation/qa-scenario.test.cjs",
    "pc:smoke:shell": "node scripts/smoke/lingjing-shell.mjs",
    "native:check": "node scripts/desktop/verify-native.cjs",
    "verify:install": "node scripts/acceptance/clean-desktop-install.mjs",
    "deps:lock": "node scripts/desktop/normalize-native-lock.mjs"
  },
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.0.9",
    "electron": "44.9.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.1",
    "eslint": "^8.57.1",
    "playwright": "^1.64.1",
    "shadcn": "^4.22.1",
    "typescript": "^5.8.2",
    "vite": "^7.3.7",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.77",
    "@assistant-ui/react": "0.15.31",
    "@supabase/supabase-js": "^2.57.4",
    "@tailwindcss/vite": "^4.3.3",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/circle": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "ai": "7.0.152",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "motion": "^14.6.0",
    "pixi.js": "^8.22.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.19.0"
  },
  "main": "apps/pc-app/dist/main/index.cjs"
}
