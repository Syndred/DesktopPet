# Desktop configuration is normally read from config/lingjing-cloud-public.json.
# Optional public-only override for a reviewed separate environment:
LINGJING_SUPABASE_URL=
LINGJING_SUPABASE_PUBLISHABLE_KEY=

# LBS providers (map integration required, local test optional)
TENCENT_MAP_KEY=
GOOGLE_MAPS_KEY=

# Server credentials belong only to the deployment environment, never desktop config.
